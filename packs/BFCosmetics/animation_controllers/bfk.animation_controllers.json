      {
       "karambit_swing2": "v.bfk == 1"
      },
      {
       "karambit_swing2_snd": "v.bfk == 1 && v.bfk_snd"
      },
      {
       "karambit_swing2_fx": "v.bfk == 1 && v.bfk_arcs"
      },
      {
       "balisong_swing2": "v.bfk == 2"
      },
      {
       "balisong_swing2_snd": "v.bfk == 2 && v.bfk_snd"
      },
      {
       "balisong_swing2_fx": "v.bfk == 2 && v.bfk_arcs"
      },
      {
       "dagger_swing2": "v.bfk == 3"
      },
      {
       "dagger_swing2_snd": "v.bfk == 3 && v.bfk_snd"
      },
      {
       "dagger_swing2_fx": "v.bfk == 3 && v.bfk_arcs"
