      },
      {
       "karambit_swing1_fx": "v.bfk == 1 && v.bfk_arcs"
      },
      {
       "balisong_swing1": "v.bfk == 2"
      },
      {
       "balisong_swing1_snd": "v.bfk == 2 && v.bfk_snd"
      },
      {
       "balisong_swing1_fx": "v.bfk == 2 && v.bfk_arcs"
