      },
      {
       "swing2": "v.bfk_a < 0.1 && v.bfk_an == 0"
      },
      {
       "idle": "v.bfk_d * v.bfk_spd > 0.95"
      }
     ],
     "blend_transition": 0.08
    },
    "insp1": {
