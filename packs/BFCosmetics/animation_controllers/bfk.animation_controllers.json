{
 "format_version": "1.10.0",
 "animation_controllers": {
  "controller.animation.bfk.tricks": {
   "initial_state": "idle",
   "states": {
    "idle": {
     "transitions": [
      {
       "draw": "v.bfk_d < 0.1"
      },
      {
       "swing1": "v.bfk_a < 0.1 && v.bfk_an == 1"
      },
      {
       "swing2": "v.bfk_a < 0.1 && v.bfk_an == 0"
      },
      {
       "insp1": "v.bfk_i < 0.1 && v.bfk_in == 1"
      },
      {
       "insp2": "v.bfk_i < 0.1 && v.bfk_in == 0"
      }
     ]
    },
    "draw": {
     "animations": [
      {
       "karambit_draw": "v.bfk == 1"
      },
      {
       "karambit_draw_snd": "v.bfk == 1 && v.bfk_snd"
      },
      {
       "balisong_draw": "v.bfk == 2"
      },
      {
       "balisong_draw_snd": "v.bfk == 2 && v.bfk_snd"
      },
      {
       "dagger_draw": "v.bfk == 3"
