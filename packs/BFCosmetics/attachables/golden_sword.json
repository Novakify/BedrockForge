      "karambit_swing2": "v.bfk == 1 && v.bfk_a * v.bfk_spd < 0.360 && v.bfk_an == 0"
     },
     {
      "karambit_swing2_snd": "v.bfk == 1 && v.bfk_a * v.bfk_spd < 0.360 && v.bfk_an == 0 && v.bfk_snd"
