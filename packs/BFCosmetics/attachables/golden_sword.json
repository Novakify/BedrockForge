     }
    ],
    "pre_animation": [
     "v.bfk = q.owner_identifier == 'minecraft:player' ? c.owning_entity->v.bfknife : 0;v.bfk_d = v.bfk > 0 ? c.owning_entity->v.bfkdraw : 99;v.bfk_i = v.bfk > 0 ? c.owning_entity->v.bfkinsp : 99;v.bfk_in = v.bfk > 0 ? c.owning_entity->v.bfkinsn : 0;v.bfk_a = v.bfk > 0 ? c.owning_entity->v.bfkatk : 99;v.bfk_an = v.bfk > 0 ? c.owning_entity->v.bfkatn : 0;v.bfk_h = v.bfk > 0 ? c.owning_entity->v.bfkhit : 99;v.bfk_hn = v.bfk > 0 ? c.owning_entity->v.bfkhitn : 0;v.bfk_spd = v.bfk > 0 ? math.clamp(c.owning_entity->v.bfkspd, 0.5, 2.0) : 1;t.o = v.bfk > 0 ? c.owning_entity->v.bfkopt : 0;v.bfk_arcs = math.mod(t.o, 2) >= 1;v.bfk_hfx = math.mod(math.floor(t.o / 2), 2) >= 1;v.bfk_snd = math.floor(t.o / 4) >= 1;v.bfk_swinging = (v.bfk == 1 && v.bfk_a * v.bfk_spd < 0.360) || (v.bfk == 2 && v.bfk_a * v.bfk_spd < 0.320) || (v.bfk == 3 && v.bfk_a * v.bfk_spd < 0.340);"
    ]
   },
   "render_controllers": [
    {
     "controller.render.item_default": "v.bfk == 0"
    },
    {
     "controller.render.bfk_knife": "v.bfk > 0"
    }
   ],
