{
 "format_version": "1.10.0",
 "minecraft:attachable": {
  "description": {
   "identifier": "minecraft:wooden_sword",
   "materials": {
    "default": "entity_alphatest",
    "enchanted": "entity_alphatest_glint"
   },
   "textures": {
    "default": "textures/items/wood_sword",
    "enchanted": "textures/misc/enchanted_item_glint",
    "karambit": "textures/bf_cosmetics/karambit",
    "balisong": "textures/bf_cosmetics/balisong",
    "dagger": "textures/bf_cosmetics/dagger"
   },
   "geometry": {
    "default": "geometry.bfk_wooden_sword",
    "karambit": "geometry.bfk_karambit",
    "balisong": "geometry.bfk_balisong",
    "dagger": "geometry.bfk_dagger"
   },
   "animations": {
    "hold_first_person": "animation.bfk.hold_first_person",
    "hold_third_person": "animation.bfk.hold_third_person",
    "bfk_tricks": "controller.animation.bfk.tricks",
    "bfk_hit_fx": "controller.animation.bfk.hit_fx",
    "bfk_hit_snd": "controller.animation.bfk.hit_snd",
    "bfk_fp": "animation.bfk.knife_fp",
    "karambit_draw": "animation.bfk.karambit.draw",
    "karambit_draw_snd": "animation.bfk.karambit.draw.snd",
    "karambit_insp1": "animation.bfk.karambit.insp1",
    "karambit_insp1_snd": "animation.bfk.karambit.insp1.snd",
    "karambit_insp2": "animation.bfk.karambit.insp2",
    "karambit_insp2_snd": "animation.bfk.karambit.insp2.snd",
    "karambit_swing1": "animation.bfk.karambit.swing1",
    "karambit_swing1_snd": "animation.bfk.karambit.swing1.snd",
    "karambit_swing1_fx": "animation.bfk.karambit.swing1.fx",
    "karambit_swing2": "animation.bfk.karambit.swing2",
    "karambit_swing2_snd": "animation.bfk.karambit.swing2.snd",
    "karambit_swing2_fx": "animation.bfk.karambit.swing2.fx",
    "balisong_draw": "animation.bfk.balisong.draw",
    "balisong_draw_snd": "animation.bfk.balisong.draw.snd",
    "balisong_insp1": "animation.bfk.balisong.insp1",
    "balisong_insp1_snd": "animation.bfk.balisong.insp1.snd",
    "balisong_insp2": "animation.bfk.balisong.insp2",
    "balisong_insp2_snd": "animation.bfk.balisong.insp2.snd",
    "balisong_swing1": "animation.bfk.balisong.swing1",
    "balisong_swing1_snd": "animation.bfk.balisong.swing1.snd",
    "balisong_swing1_fx": "animation.bfk.balisong.swing1.fx",
    "balisong_swing2": "animation.bfk.balisong.swing2",
    "balisong_swing2_snd": "animation.bfk.balisong.swing2.snd",
    "balisong_swing2_fx": "animation.bfk.balisong.swing2.fx",
    "dagger_draw": "animation.bfk.dagger.draw",
    "dagger_draw_snd": "animation.bfk.dagger.draw.snd",
    "dagger_insp1": "animation.bfk.dagger.insp1",
    "dagger_insp1_snd": "animation.bfk.dagger.insp1.snd",
    "dagger_insp2": "animation.bfk.dagger.insp2",
    "dagger_insp2_snd": "animation.bfk.dagger.insp2.snd",
    "dagger_swing1": "animation.bfk.dagger.swing1",
    "dagger_swing1_snd": "animation.bfk.dagger.swing1.snd",
    "dagger_swing1_fx": "animation.bfk.dagger.swing1.fx",
    "dagger_swing2": "animation.bfk.dagger.swing2",
    "dagger_swing2_snd": "animation.bfk.dagger.swing2.snd",
    "dagger_swing2_fx": "animation.bfk.dagger.swing2.fx"
   },
   "scripts": {
    "animate": [
     {
      "hold_first_person": "c.is_first_person"
     },
     {
      "hold_third_person": "!c.is_first_person"
     },
     {
      "bfk_tricks": "v.bfk > 0"
     },
     {
      "bfk_hit_fx": "v.bfk > 0 && v.bfk_hfx"
     },
     {
      "bfk_hit_snd": "v.bfk > 0 && v.bfk_snd"
     },
     {
      "bfk_fp": "v.bfk > 0 && c.is_first_person"
     }
    ],
    "pre_animation": [
     "v.bfk = q.owner_identifier == 'minecraft:player' ? c.owning_entity->v.bfknife : 0;v.bfk_d = v.bfk > 0 ? c.owning_entity->v.bfkdraw : 99;v.bfk_i = v.bfk > 0 ? c.owning_entity->v.bfkinsp : 99;v.bfk_in = v.bfk > 0 ? c.owning_entity->v.bfkinsn : 0;v.bfk_a = v.bfk > 0 ? c.owning_entity->v.bfkatk : 99;v.bfk_an = v.bfk > 0 ? c.owning_entity->v.bfkatn : 0;v.bfk_h = v.bfk > 0 ? c.owning_entity->v.bfkhit : 99;v.bfk_hn = v.bfk > 0 ? c.owning_entity->v.bfkhitn : 0;v.bfk_spd = v.bfk > 0 ? math.clamp(c.owning_entity->v.bfkspd, 0.5, 2.0) : 1;t.o = v.bfk > 0 ? c.owning_entity->v.bfkopt : 0;v.bfk_arcs = math.mod(t.o, 2) >= 1;v.bfk_hfx = math.mod(math.floor(t.o / 2), 2) >= 1;v.bfk_snd = math.floor(t.o / 4) >= 1;"
    ]
   },
   "render_controllers": [
    {
     "controller.render.item_default": "v.bfk == 0"
    },
    {
     "controller.render.bfk_knife": "v.bfk > 0"
    }
   ],
   "sound_effects": {
    "swish": "bfk.swish",
    "cut": "bfk.cut",
    "click": "bfk.click",
    "ring_spin": "bfk.ring_spin",
    "clack": "bfk.clack",
    "latch": "bfk.latch",
    "draw": "bfk.draw",
    "dagger_catch": "bfk.dagger_catch"
   },
   "particle_effects": {
    "arc": "bfk:arc",
    "spark": "bfk:spark",
    "cutflash": "bfk:cutflash"
   }
  }
 }
}