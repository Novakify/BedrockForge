{
 "format_version": "1.8.0",
 "render_controllers": {
  "controller.render.bfk_knife": {
   "arrays": {
    "geometries": {
     "Array.kgeo": [
      "Geometry.karambit"
     ]
    },
    "textures": {
     "Array.ktex": [
      "Texture.karambit"
     ]
    }
   },
   "geometry": "Array.kgeo[v.bfk - 1]",
   "materials": [
    {
     "*": "v.is_enchanted ? Material.enchanted : Material.default"
    },
    {
     "bfk_neon": "Material.neon"
    }
   ],
   "textures": [
    "Array.ktex[v.bfk - 1]",
    "Texture.enchanted"
   ]
  }
 }
}