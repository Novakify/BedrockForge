            float du = wrap180(az - BAZ) * cos(radians(el)) / rad, dv = (el - BEL) / rad;
            float maria = lfNoise(du * 2.2 + 3.1, dv * 2.2 - 1.7, 2.4) * 0.6 + lfNoise(du * 5.0, dv * 5.0, 7.3) * 0.4;
            vec3 moonC = PRESET == 12 ? eclipseMoon(du, dv, limb, maria) : BCOL * (0.62 + 0.38 * limb) * (0.82 + 0.3 * maria) * 1.15;
            C = mix(C, moonC, disc * 0.96);
        }
    } else if (BKIND == SYNTH_K) {
        float o = max(0.0, ang - rad);
        add(A1, exp(-o / 10.0) * 0.45 + exp(-o / 3.0) * 0.35);
        // [BF] the retro sun itself (in game it was only a glow): yellow-to-pink disc, cut by bands that widen downward
        if (ang < rad) {
            float dy = el - BEL;
            float k = clamp(dy / rad * 0.5 + 0.5, 0.0, 1.0);
            vec3 sunC = mix(A1 * 1.1, BCOL * 1.15, k * k);
            float cut = 1.0;
            if (dy < 0.0) {
                float u = -dy / rad;
                float band = fract(u * 5.0 - T * 0.05);
                cut = step(0.16 + 0.42 * u, band);
            }
            float inside = sm(rad, rad * 0.94, ang);
            over(sunC, cut * inside);
            over(mix(TOP, HOR, 0.6) * 0.55, (1.0 - cut) * inside * 0.9); // the gaps show the sky behind, not the glow
        }
    } else {
        if (ang < rad) {
            over(vec3(0.008, 0.004, 0.02), 1.0);
            return;
        }
        float around = atan2(el - BEL, wrap180(az - BAZ));
        float fl = 0.6 + 0.5 * lfNoise(cos(around) * 3.0, T * 0.9 + sin(around) * 3.0, 5.0);
        float a5 = around + T * 0.02;
        float nn = lfNoise(cos(a5) * 5.0 + 9.0, T * 0.35 + sin(a5) * 5.0, 2.0);
        float streams = 0.5 + 1.0 * nn * nn * 2.0;
        float o = ang - rad;
        add(A1, exp(-o / 1.6) * 1.2 * fl);
        add(A2, exp(-o / 7.0) * 0.45 * streams * PATTERN);
    }
}

// ================================================================ Gemalte Himmel (Polar, Galaxy, Ocean, Ice, Purple, Sunset, Sakura, Blood Moon, Storm)
// Richtung d (Einheitsvektor, y = oben), Zeit t in Sekunden. Liefert Farbe (0..1+).

float sh21(vec2 p) { vec3 q = fract(SPLAT3(p.xyx) * .1031); q += dot(q, q.yzx + 33.33); return fract((q.x + q.y) * q.z); }
float sh31(vec3 q) { q = fract(q * .1031); q += dot(q, q.zyx + 31.32); return fract((q.x + q.y) * q.z); }
vec3 sh33(vec3 q) { q = fract(q * vec3(.1031, .1030, .0973)); q += dot(q, q.yxz + 33.33); return fract((q.xxy + q.yxx) * q.zyx); }
float sn2(vec2 p) {
    vec2 i = floor(p), f = fract(p); f = f * f * (3. - 2. * f);
    return mix(mix(sh21(i), sh21(i + vec2(1, 0)), f.x), mix(sh21(i + vec2(0, 1)), sh21(i + vec2(1, 1)), f.x), f.y);
}
float sn3(vec3 p) {
    vec3 i = floor(p), f = fract(p); f = f * f * (3. - 2. * f);
    return mix(mix(mix(sh31(i), sh31(i + vec3(1, 0, 0)), f.x), mix(sh31(i + vec3(0, 1, 0)), sh31(i + vec3(1, 1, 0)), f.x), f.y),
               mix(mix(sh31(i + vec3(0, 0, 1)), sh31(i + vec3(1, 0, 1)), f.x), mix(sh31(i + vec3(0, 1, 1)), sh31(i + vec3(1, 1, 1)), f.x), f.y), f.z);
}
float sf2(vec2 p, int o) {
    float s = 0., a = .5;
    mat2 m = mat2(1.6, 1.2, -1.2, 1.6);
    for (int i = 0; i < 6; i++) { if (i >= o) break; s += a * sn2(p); p = MUL2(m, p); a *= .5; }
    return s / (1. - pow(.5, float(o)));
}
float sf3(vec3 p, int o) {
    float s = 0., a = .5;
    for (int i = 0; i < 5; i++) { if (i >= o) break; s += a * sn3(p); p = p * 2.03 + 17.1; a *= .5; }
    return s / (1. - pow(.5, float(o)));
}
vec3 sdir(float azDeg, float elDeg) {
    float a = radians(azDeg), e = radians(elDeg);
    return vec3(-sin(a) * cos(e), sin(e), cos(a) * cos(e));
}
// lokale Koordinaten um eine Richtung c (fuer Scheiben, Galaxie, Blitze), Einheit = Bogenmass
vec2 slocal(vec3 d, vec3 c) {
    vec3 u = normalize(cross(vec3(0, 1, 0), c)), v = cross(c, u);
    return vec2(dot(d, u), dot(d, v)) / max(dot(d, c), 1e-3);
}

// ---------------- Sterne
vec3 sStars(vec3 d, float dens, float t) {
    vec3 c = SPLAT3(0);
    for (int l = 0; l < 2; l++) {
        float sc = l == 0 ? 140. : 330., th = 1. - dens * (l == 0 ? .03 : .06);
        vec3 p = d * sc, id = floor(p), f = fract(p);
        float h = sh31(id + float(l) * 19.);
        if (h > th) {
            vec3 o = sh33(id) * .5 + .25;
            float dd = length(f - o), br = (h - th) / (1. - th);
            float tw = .7 + .3 * sin(t * (1.3 + h * 3.) + h * 70.);
            vec3 tint = mix(vec3(1., .85, .7), vec3(.75, .85, 1.), sh33(id + 5.).x);
            c += smoothstep(l == 0 ? .2 : .26, 0., dd) * (.35 + br * 1.4) * tw * tint;
        }
    }
    return c;
}

// ---------------- Wolken: gemalt, mit leuchtenden Kanten zur Lichtquelle
// lp = Lichtrichtung, scale = Groesse, cov = Bedeckung, drift = Wind
vec4 sClouds(vec3 d, vec3 lp, float scale, float cov, float t, float drift) {
    if (d.y < -.02) return SPLAT4(0);
    float k = 1. / (d.y + .14);
    vec2 p = d.xz * k * scale + vec2(t * drift, t * drift * .35);
    vec2 w = vec2(sf2(p * .5 + 3.1, 3), sf2(p * .5 + 7.7, 3));
    vec2 q = p + (w - .5) * .9;
    float n = sf2(q, 5) + (sn2(q * 5.3) - .5) * .07;
    float th = mix(.66, .32, cov);
    float den = smoothstep(th, th + .1, n);
    // Licht: Dichte etwas in Richtung Licht versetzt -> Kanten zur Lichtquelle leuchten
    vec2 l2 = normalize(lp.xz + 1e-4) * .22;
    float n2 = sf2(q + l2, 5) + (sn2((q + l2) * 5.3) - .5) * .07;
    float lfLit = clamp((n - n2) * 9. + .45, 0., 1.);
    lfLit = lfLit * lfLit * (3. - 2. * lfLit);
    float edge = smoothstep(th - .01, th + .05, n) * (1. - smoothstep(th + .05, th + .2, n)) * (.4 + .6 * lfLit);
    return vec4(lfLit, edge, den * smoothstep(-.02, .06, d.y), n);
}

// ---------------- Lichtsaeule (senkrechter Strahl) bei Azimut az
float sBeam(vec3 d, float az, float width, float t) {
    vec3 b = sdir(az, 0.);
    float h = dot(normalize(d.xz + 1e-5), normalize(b.xz));
    float ang = acos(clamp(h, -1., 1.));
    float w = width * (1. + d.y * .6);
    float flick = .85 + .15 * sin(t * 2.3 + d.y * 9.);
    float core = exp(-ang * ang / (w * w * .08)) * 1.6;
    float halo = exp(-ang * ang / (w * w)) * .7 + exp(-ang / (w * 4.)) * .18;
    return (core + halo) * flick * smoothstep(-.05, .25, d.y) * step(0., h);
}

// ---------------- Planet mit Licht, Atmosphaere und Ring (gibt die neue Farbe zurueck)
vec3 sPlanet(vec3 col, vec3 d, vec3 c, float r, vec3 pc, vec3 atm, vec3 lightDir, float ring) {
    if (dot(d, c) < .5) return col;
    vec2 q = slocal(d, c) / r;
    float rr = length(q);
    vec2 rq = vec2(q.x * cos(.35) - q.y * sin(.35), q.x * sin(.35) + q.y * cos(.35));
    float e = length(vec2(rq.x, rq.y / .22));
    float band = ring * smoothstep(1.35, 1.45, e) * (1. - smoothstep(2.1, 2.25, e)) * (.55 + .45 * sin(e * 30.));
    // Ring hinter dem Planeten
    if (rq.y > 0.) col = mix(col, pc * 1.3 + .15, band * .75);
    // Schein
    col += atm * exp(-max(rr - 1., 0.) * 8.) * .35 * step(1., rr);
    if (rr < 1.) {
        vec3 n = vec3(q, sqrt(1. - rr * rr));
        float lam = clamp(dot(n, normalize(lightDir)), 0., 1.);
        float bands = .8 + .2 * sin(q.y * 9. + sf2(q * 3., 3) * 4.);
        vec3 s = pc * bands * (.06 + 1.1 * lam) + atm * pow(1. - n.z, 3.) * .9;
        col = mix(col, s, smoothstep(1., .96, rr));
    }
    // Ring vor dem Planeten
    if (rq.y <= 0.) col = mix(col, pc * 1.3 + .15, band * .75);
    return col;
}
// ---------------- Spiralgalaxie
vec3 sGalaxy(vec3 d, vec3 c, float size, float t) {
    if (dot(d, c) < .6) return SPLAT3(0);
    vec2 q = slocal(d, c) / size;
    float ca = cos(.5), sa = sin(.5);
    q = vec2(q.x * ca - q.y * sa, q.x * sa + q.y * ca);
    q.y /= .42;
    float r = length(q), a = atan2(q.y, q.x);
    float arms = pow(.5 + .5 * sin(2. * a - log(r + .02) * 5. + t * .03), 2.5);
    float n = sf2(q * 6. + 3., 4);
    float disk = exp(-r * 2.6) * (.25 + arms * 1.2) * (.55 + .7 * n);
    float core = exp(-r * r * 60.) * 2.2 + exp(-r * 7.) * .6;
    vec3 col = mix(vec3(.55, .45, 1.), vec3(1., .75, .9), arms) * disk + vec3(1., .92, .8) * core;
    float dust = smoothstep(.55, .75, sf2(q * 9. + 11., 3)) * arms * exp(-r * 3.);
    return col * (1. - .6 * dust);
}

// ---------------- Polarlicht-Vorhaenge
vec3 sAurora(vec3 d, float t, vec3 c1, vec3 c2) {
    if (d.y < .01) return SPLAT3(0);
    vec3 acc = SPLAT3(0);
    for (int i = 0; i < 26; i++) {
        float k = float(i) / 26., h = 1. + k * 1.4;
        vec2 p = d.xz / d.y * h;
        float wave = sin(p.x * .5 + t * .14) * 1.1 + sin(p.x * 1.6 - t * .2 + 1.3) * .4 + (sn2(vec2(p.x * .35, t * .05)) - .5) * 2.4;
        float dd = p.y - 4.5 - wave;
        float curtain = exp(-dd * dd * 1.2);
        float rays = pow(sn2(vec2(p.x * 6. + wave * 2., t * .3)), 2.) * 1.5 + .2;
        acc += mix(c1, c2, smoothstep(.2, .9, k)) * curtain * rays * exp(-k * 2.) * (1. + 2.5 * exp(-k * 25.));
    }
    return acc * .14 * smoothstep(.01, .12, d.y);
}

// ---------------- Blitz (gezackte Linie mit Aesten) um Azimut az
float sBolt(vec3 d, float az, float seed, float t) {
    vec3 c = sdir(az, 22.);
    if (dot(d, c) < .7) return 0.;
    vec2 q = slocal(d, c);
    if (q.y > .32 || q.y < -.42) return 0.;
    float y = q.y;
    float x = (sn2(vec2(y * 9., seed)) - .5) * .09 + (sn2(vec2(y * 30., seed + 3.)) - .5) * .025;
    float main = exp(-abs(q.x - x) * 260.) + exp(-abs(q.x - x) * 45.) * .35;
    float bx = x + (y - .05) * .5 + (sn2(vec2(y * 28., seed + 9.)) - .5) * .03;
    float br = (exp(-abs(q.x - bx) * 300.) + exp(-abs(q.x - bx) * 60.) * .2) * step(y, .05) * step(-.25, y) * .7;
    return (main + br) * smoothstep(.32, .2, y);
}

float sFlash(float t, float seed) {
    float c = floor(t / 2.6 + seed), l = fract(t / 2.6 + seed) * 2.6;
    if (sh21(vec2(c, seed * 7.)) < .3) return 0.;
    return (l < .08 ? 1. : 0.) + (l > .14 && l < .2 ? .75 : 0.) + (l > .2 ? exp(-(l - .2) * 8.) * .4 : 0.);
}

// ---------------- Kirschblueten-Zweige oben im Bild
vec4 sSakura(vec3 d, float t) {
    float el = degrees(asin(clamp(d.y, -1., 1.)));
    if (el < 16.) return SPLAT4(0);
    float az = atan2(-d.x, d.z);
    vec2 p = vec2(az * 3.2, (90. - el) / 18.);
    float m = sf2(p * 1.4 + 2., 4);
    float zone = smoothstep(.35, .95, sin(az * 2. + 1.2) * .5 + .5) * smoothstep(16., 40., el);
    // Aeste: duenne dunkle Linien
    float br = abs(sin(p.x * 2.3 + sf2(p * 2., 3) * 4.) * .5 + p.y * .9 - 1.2 - .6 * sin(p.x * .7));
    float branch = smoothstep(.035, .0, br - .015) * zone;
    // Blueten: Haufen kleiner runder Flecken
    float near = smoothstep(.45, .05, br) * zone;
    float blossom = 0.;
    vec2 id = SPLAT2(0);
    for (int k = 0; k < 2; k++) {
        vec2 g = p * (k == 0 ? 6. : 9.5) + float(k) * 3.7;
        vec2 cid = floor(g), f = fract(g) - .5;
        float h = sh21(cid + float(k) * 11.);
        float rad = .28 + .14 * sh21(cid + 5.);
        float bl = smoothstep(rad, rad - .12, length(f + (sh33(vec3(cid, 2.)).xy - .5) * .5)) * step(.3, h);
        if (bl > blossom) { blossom = bl; id = cid; }
    }
    blossom *= near * smoothstep(.3, .55, m + near * .3);
    vec3 bc = mix(vec3(1., .55, .8), vec3(1., .85, .95), sh21(id + 3.));
    float a = max(blossom, branch);
    vec3 col = mix(vec3(.18, .05, .12), bc, blossom / max(a, 1e-3));
    return vec4(col, a);
}

// ================================================================ die neun Himmel
vec3 styledSky(vec3 d, int id, float t) {
    float y = d.y;
    float el = degrees(asin(clamp(y, -1., 1.)));
    float hz = exp(-max(y, 0.) * 6.);
    vec3 col;
    if (id == 0) { // POLAR
        col = mix(vec3(.02, .09, .16), vec3(.0, .02, .06), smoothstep(0., .8, y));
        col += vec3(.0, .25, .35) * hz * .6;
        col += sStars(d, .8, t) * .9;
        col += sAurora(d, t, vec3(.1, 1., .7), vec3(.2, .5, 1.)) * 1.3;
        float b = sBeam(d, 0., .045, t);
        col += vec3(.45, .95, 1.) * b * .4;   // [BF] the light pillar is an accent, not the subject
        vec4 c = sClouds(d, sdir(0., 10.), 1.1, .35, t, .02);
        vec3 cc = mix(vec3(.01, .05, .1), vec3(.1, .45, .55), c.x) + vec3(.3, 1., .95) * c.y * .9;
        col = mix(col, cc, c.z * .85 * smoothstep(.0, .35, 1. - y));
    } else if (id == 1) { // GALAXY
        col = mix(vec3(.05, .02, .14), vec3(.01, .0, .04), smoothstep(0., .9, y));
        float neb = sf3(d * 2.2 + 4., 4);
        col += mix(vec3(.35, .1, .55), vec3(.1, .2, .6), sf3(d * 1.3, 3)) * smoothstep(.45, .85, neb) * .55;
        col += sStars(d, 1.6, t) * 1.2;
        col += sGalaxy(d, sdir(10., 26.), .32, t) * 1.3;
        col = sPlanet(col, d, sdir(330., 32.), .075, vec3(.55, .45, .9), vec3(.6, .5, 1.), vec3(.7, .3, .6), 1.);
        col = sPlanet(col, d, sdir(60., 14.), .05, vec3(.4, .5, .9), vec3(.4, .6, 1.), vec3(-.8, .3, .5), 0.);
        col += vec3(.3, .2, .7) * hz * .35;
    } else if (id == 2) { // OCEAN
        col = mix(vec3(.15, .75, .9), vec3(.02, .2, .45), smoothstep(-.05, .7, y));
        // [BF] a sea sky, not a stock day sky: high sun glare, lighter scattered clouds with turquoise undersides
        vec3 sunO = sdir(180., 55.);
        float so = max(dot(d, sunO), 0.);
        col += vec3(1., .98, .9) * (pow(so, 40.) * .6 + pow(so, 600.) * 1.5);
        vec4 c = sClouds(d, sunO, 1.3, .42, t, .03);
        vec3 cc = mix(vec3(.10, .45, .60), vec3(.85, .97, 1.), c.x) + vec3(1., 1., 1.) * c.y * .45;
        col = mix(col, cc, c.z * .82);
        float rays = pow(sn2(vec2(atan2(d.x, d.z) * 9., t * .1)), 3.) * smoothstep(.1, .7, y);
        col += vec3(.5, .95, 1.) * rays * .16;
        col += vec3(.6, 1., 1.) * hz * .25;
    } else if (id == 3) { // ICE
        // [BF] glacial, not electric blue: pale ice-white horizon, steel blue above, crystal sparkle
        col = mix(vec3(.72, .86, .96), vec3(.06, .15, .34), smoothstep(-.05, .75, y));
        col += sStars(d, .8, t) * .6 * smoothstep(.3, .8, y);
        float glint = pow(sh21(floor(d.xz / max(d.y + .3, .2) * 90.) + floor(t * 1.5)), 60.) * smoothstep(.0, .5, y);
        col += vec3(.9, .97, 1.) * glint * .8;
        float b = sBeam(d, 0., .05, t);
        vec4 c = sClouds(d, sdir(0., 20.), 1.0, .6, t, .02);
        float near = pow(max(dot(normalize(d.xz + 1e-4), vec2(0, 1)), 0.), 6.);
        vec3 cc = mix(vec3(.10, .20, .38), vec3(.78, .88, .98), c.x) + vec3(.95, .98, 1.) * c.y * (.4 + near * .4);
        col = mix(col, cc, c.z * .92);
        col += vec3(.75, .9, 1.) * b * .35;
    } else if (id == 4) { // PURPLE
        col = mix(vec3(.25, .08, .45), vec3(.04, .01, .12), smoothstep(-.05, .8, y));
        col += sStars(d, 1., t) * .8;
        float b = sBeam(d, 0., .04, t);
        vec4 c = sClouds(d, sdir(0., 15.), 1.15, .5, t, .02);
        // [BF] richer, less neon: cool blue-violet shadows, softer lilac light (one flat purple read as cheap in game)
        vec3 cc = mix(vec3(.05, .03, .18), vec3(.46, .28, .76), c.x) + vec3(.92, .74, 1.) * c.y * .55;
        col = mix(col, cc, c.z * .88);
        col += vec3(.75, .45, 1.) * b * .45;
        col = sPlanet(col, d, sdir(320., 38.), .06, vec3(.5, .3, .8), vec3(.8, .5, 1.), vec3(.6, .2, .7), 0.);
        col = sPlanet(col, d, sdir(40., 40.), .035, vec3(.6, .4, .9), vec3(.8, .6, 1.), vec3(-.6, .2, .7), 0.);
    } else if (id == 5) { // SUNSET
        vec3 sun = sdir(30., 2.);
        float sd = max(dot(d, sun), 0.);
        col = mix(vec3(1., .45, .15), vec3(.18, .1, .35), smoothstep(-.05, .55, y));
        col += vec3(1., .5, .2) * pow(sd, 8.) * .8 + vec3(1., .85, .5) * pow(sd, 200.) * 2.;
        vec4 c = sClouds(d, sun, 1.0, .58, t, .015);
        vec3 shade = mix(vec3(.3, .08, .15), vec3(.12, .06, .2), smoothstep(0., .5, y));
        vec3 cc = mix(shade, vec3(1., .45, .2), c.x) + vec3(1., .75, .4) * c.y * (.5 + pow(sd, 4.) * 1.5);
        col = mix(col, cc, c.z * .92);
        float rays = pow(sn2(vec2(atan2(dot(d, normalize(cross(sun, vec3(0, 1, 0)))), y) * 14., 1.)), 3.) * pow(sd, 3.);
        col += vec3(1., .6, .3) * rays * .25;
    } else if (id == 6) { // SAKURA
        col = mix(vec3(.55, .2, .5), vec3(.12, .04, .2), smoothstep(-.05, .7, y));
        col += sStars(d, .7, t) * .6 * smoothstep(.2, .7, y);
        vec3 mc = sdir(0., 28.);
        float ma = acos(clamp(dot(d, mc), -1., 1.));
        float disc = smoothstep(.06, .055, ma);
        col += vec3(1., .5, .85) * (exp(-ma * 9.) * .5 + exp(-ma * 30.) * .5);
        vec4 c = sClouds(d, mc, 1.1, .45, t, .015);
        vec3 cc = mix(vec3(.25, .06, .25), vec3(.95, .45, .8), c.x) + vec3(1., .75, .95) * c.y * .8;
        col = mix(col, cc, c.z * .85);
        col = mix(col, vec3(1., .82, .95) * (.85 + .15 * sf2(slocal(d, mc) * 40., 3)), disc);
        vec4 s = sSakura(d, t);
        col = mix(col, s.rgb, s.a);
    } else if (id == 7) { // BLOOD MOON
        col = mix(vec3(.16, .015, .03), vec3(.03, .0, .012), smoothstep(-.05, .7, y)); // [BF] deep maroon, not flat red
        vec3 mc = sdir(0., 26.);
        float ma = acos(clamp(dot(d, mc), -1., 1.));
        float r = .055;
        float ring = exp(-pow((ma - r) * 90., 2.)) * 2.2 + exp(-max(ma - r, 0.) * 18.) * 1.1;
        float flame = .7 + .3 * sn2(vec2(atan2(slocal(d, mc).y, slocal(d, mc).x) * 6., t * .5));
        vec4 c = sClouds(d, mc, 1.1, .6, t, .02);
        vec3 cc = mix(vec3(.04, .0, .012), vec3(.40, .05, .07), c.x) + vec3(.95, .40, .28) * c.y * .45;
        col = mix(col, cc, c.z * .92);
        col += vec3(1., .15, .08) * ring * flame;
        col = mix(col, vec3(.01, 0., 0.), smoothstep(r, r * .97, ma));
    } else if (id == 9) { // [LyricsForge] ASTRAL SYMPHONY: a concert hall of stars - golden/violet ribbons, harmonic rings
        col = mix(vec3(.10, .05, .24), vec3(.01, .0, .05), smoothstep(-.05, .85, y));
        col += sStars(d, 1.8, t) * 1.25;
        col += sGalaxy(d, sdir(200., 38.), .42, t) * 1.1;
        col += sAurora(d, t * .8, vec3(1., .78, .35), vec3(.62, .35, 1.)) * 1.1;
        float za = acos(clamp(y, -1., 1.));                                  // angle from the zenith
        float rings = exp(-pow((fract(za * 3.2 - t * .04) - .5) * 9., 2.)) * smoothstep(.15, .75, y);
        col += mix(vec3(1., .8, .45), vec3(.7, .5, 1.), .5 + .5 * sin(za * 6. + t * .3)) * rings * (.10 + .10 * BREATH);
        col += vec3(.45, .3, .8) * hz * .35;
    } else if (id == 10) { // [LyricsForge] ECLIPSE HEARTBEAT: a black sun whose corona beats like a heart
        vec3 mc = sdir(10., 30.);
        float ma = acos(clamp(dot(d, mc), -1., 1.));
        float r = .065;
        float ph = fract(t * 1.15);
        float beat = exp(-ph * 9.) + .65 * exp(-max(ph - .2, 0.) * 9.) * step(.2, ph) + .5 * BREATH;
        col = mix(vec3(.16, .02, .05), vec3(.015, .0, .02), smoothstep(-.05, .7, y));
        col += sStars(d, .6, t) * .45 * smoothstep(.25, .8, y);
        vec2 lp = slocal(d, mc);
        float rays = .55 + .45 * sn2(vec2(atan2(lp.y, lp.x) * 7., t * .35));
        float corona = exp(-max(ma - r, 0.) * (24. - 8. * beat)) * rays * (1. + 1.4 * beat);
        float ring = exp(-pow((ma - r) * 110., 2.)) * (2. + 1.5 * beat);
        col += vec3(1., .35, .25) * corona * .9 + vec3(1., .85, .7) * ring;
        col += vec3(.6, .05, .08) * exp(-ma * 3.) * (.25 + .35 * beat);        // the whole sky blushes on each beat
        vec4 c = sClouds(d, mc, 1.0, .4, t, .015);
        col = mix(col, mix(vec3(.05, .0, .02), vec3(.55, .1, .12), c.x) + vec3(1., .4, .3) * c.y * .6, c.z * .6);
        col = mix(col, vec3(.005, 0., .005), smoothstep(r, r * .96, ma));       // the dark moon in front
    } else if (id == 11) { // [LyricsForge] DREAM OCEAN: pastel dusk over a glassy sea (reworked after an in-game look:
        // it read as ordinary daytime clouds). Peach horizon, lilac middle, deep violet-blue above; a low, soft sun with
        // its glare; few thin clouds lit gold-pink from below; slow caustic light overhead; first stars at the top
        col = mix(vec3(1., .74, .62), vec3(.74, .60, .88), smoothstep(-.02, .30, y));
        col = mix(col, vec3(.20, .22, .50), smoothstep(.28, .85, y));
        col = mix(col, vec3(.07, .07, .22), smoothstep(.80, 1., y));
        vec3 mc = sdir(0., 8.);
        float ma = acos(clamp(dot(d, mc), -1., 1.));
        col += vec3(1., .80, .62) * (exp(-ma * 3.5) * .35 + exp(-ma * 12.) * .45);       // the glare over the water
        col = mix(col, vec3(1., .93, .82), smoothstep(.05, .045, ma));                  // the sun, sitting on the sea
        vec4 c = sClouds(d, mc, 1.4, .32, t, .012);
        vec3 lit = mix(vec3(.46, .38, .66), vec3(1., .72, .66), c.x);
        col = mix(col, lit + vec3(1., .86, .7) * c.y * .7, c.z * .6);
        vec2 cp = d.xz / max(y + .35, .2) * 2.5;
        float ca = pow(1. - abs(sn2(cp + vec2(t * .08, t * .05)) * 2. - 1.), 7.) * pow(1. - abs(sn2(cp * 1.7 - vec2(t * .06, 0.)) * 2. - 1.), 5.);
        col += vec3(.75, .95, 1.) * ca * smoothstep(.45, .95, y) * .18;
        col += sStars(d, .7, t) * .6 * smoothstep(.62, .95, y);
        col += vec3(1., .78, .7) * hz * .25;
    } else if (id == 12) { // [LyricsForge] METEOR CHORUS: a clear night where meteors sing across the sky in waves
        col = mix(vec3(.05, .09, .22), vec3(.0, .01, .05), smoothstep(-.05, .8, y));
        col += sStars(d, 1.4, t) * 1.1;
        float met = 0.;
        for (int k = 0; k < 6; k++) {
            float P = 1.6 + float(k) * .41, ph = fract(t / P + float(k) * .17), cid = floor(t / P + float(k) * .17);
            vec3 hh = sh33(vec3(cid, float(k), 3.));
            vec3 a0 = sdir(hh.x * 360., 35. + hh.y * 40.);
            vec3 tg = normalize(cross(a0, vec3(0, 1, 0)) * (hh.z > .5 ? 1. : -1.) - vec3(0, .45, 0));
            vec3 head = normalize(a0 + tg * ph * .5);
            vec2 lp = slocal(d, head);
            vec2 dirL = normalize(slocal(normalize(head - tg * .05), head) + 1e-4);
            float along = dot(lp, dirL), across = abs(dot(lp, vec2(-dirL.y, dirL.x)));
            float tail = smoothstep(.18, 0., along) * step(0., along) * smoothstep(.004, 0., across);
            float bright = smoothstep(0., .15, ph) * smoothstep(1., .6, ph) * step(.0, dot(d, head));
            met += (tail * (1. - along / .18) + exp(-dot(lp, lp) * 9000.) * 2.) * bright;
        }
        col += vec3(.75, .9, 1.) * met;
        col += vec3(.2, .35, .7) * hz * .35;
    } else { // STORM
        col = mix(vec3(.08, .14, .28), vec3(.01, .03, .08), smoothstep(-.05, .7, y));
        float f1 = sFlash(t, .0), f2 = sFlash(t + 1.3, .5);
        vec4 c = sClouds(d, sdir(0., 30.), 1.2, .8, t, .04);
        vec3 cc = mix(vec3(.02, .04, .1), vec3(.25, .35, .6), c.x) + vec3(.5, .65, 1.) * c.y * .5;
        cc += vec3(.6, .7, 1.) * (f1 + f2) * .35 * (.5 + c.w);
        col = mix(col, cc, c.z * .95);
        float b = sBolt(d, 10., floor(t / 2.6), t) * f1 + sBolt(d, 300., floor((t + 1.3) / 2.6) + 50., t) * f2;
        col += vec3(.7, .8, 1.) * b * 1.4;
    }
    // Boden-Uebergang unter dem Horizont
    col *= 1. - clamp(-el / 8., 0., 1.) * .5;
    return col;
}


// ================================================================ LyricsFlow 2.2: the five newest (Rift, Supernova, Warp, Silk, Eclipse)
// ported from live_sky.fsh 2.2 (noise -> lfNoise, atan(y, x) -> atan2)
float angAround(vec3 d, vec3 c) {
    vec3 u = normalize(vec3(c.z, 0.0, -c.x) + vec3(1e-9, 0.0, 0.0));
    vec3 v = vec3(c.y * u.z, c.z * u.x - c.x * u.z, -c.y * u.x);
    return atan2(dot(d, v), dot(d, u));
}

void addMix(float k, float inten) {
    add(mix(A1, A2, clamp(k, 0.0, 1.0)), inten);
}

void rift(float x, float y, float z) {
    float d = -x * 0.513 + y * 0.42 - z * 0.747;
    float t = T * 0.05 * (0.5 + LIVELY);
    float wob = (fbm(x * 3.0 + t, y * 3.0 - t, z * 3.0, 3) - 0.5) * 0.16 + (lfNoise(x * 14.0, y * 14.0 + T * 0.4, z * 14.0) - 0.5) * 0.03;
    float dd = d + wob;
    float along = fbm(x * 5.0 - t * 3.0, y * 5.0, z * 5.0 + t * 2.0, 2);
    float open = 0.6 + 0.4 * sin(T * 0.7 + along * 6.0);
    float core = exp(-dd * dd / (0.00018 * open));
    float edge = exp(-dd * dd / 0.0025);
    float glow = exp(-abs(dd) / 0.09);
    addMix(sm(0.35, 0.65, along), edge * 0.9 * PATTERN * BREATH);
    add(SPLAT3(1.0), core * 1.2 * PATTERN);
    add(A1, glow * 0.22 * PATTERN);
    add(mix(A1, A2, 0.5), exp(-abs(dd) / 0.35) * 0.12 * PATTERN);
    float w = fbm(x * 2.2 + dd * 6.0, y * 2.2 - t * 2.0, z * 2.2 + t, 3);
    float wisp = pow(1.0 - abs(2.0 * w - 1.0), 8.0) * exp(-abs(dd) / 0.25);
    addMix(1.0 - w, wisp * 0.45 * PATTERN);
}

void supernova(float x, float y, float z) {
    vec3 d = vec3(x, y, z), c = sdir(200.0, 30.0);
    float ang = degrees(acos(clamp(dot(d, c), -1.0, 1.0)));
    float th = angAround(d, c);
    float flick = 0.85 + 0.15 * sin(T * 3.0);
    add(SPLAT3(1.0), (exp(-ang / 0.9) * 1.3 + exp(-ang / 4.0) * 0.45) * flick);
    add(A1, exp(-ang / 12.0) * 0.35 * BREATH);
    float rays = pow(0.5 + 0.5 * sin(th * 13.0 + lfNoise(th * 3.0, T * 0.2, 1.0) * 4.0), 10.0) * exp(-ang / 18.0);
    add(mix(vec3(1.0, 0.9, 0.8), A1, 0.4), rays * 0.22 * PATTERN);
    for (int i = 0; i < 2; i++) {
        float R = fract(T * 0.07 + float(i) * 0.5) * 85.0;
        float rd = (ang - R) / (1.5 + R * 0.05);
        float ring = exp(-rd * rd) * (1.0 - R / 85.0);
        addMix(1.0 - float(i), ring * 0.55 * PATTERN);
    }
    float n = fbm(x * 3.0 + 2.0, y * 3.0 + T * 0.01, z * 3.0, 3);
    float fil = pow(1.0 - abs(2.0 * n - 1.0), 6.0) * exp(-ang / 45.0);
    addMix(fbm(x * 1.5, y * 1.5, z * 1.5 + 5.0, 2), fil * 0.7 * PATTERN);
}

void warp(float x, float y, float z) {
    vec3 d = vec3(x, y, z), c = sdir(0.0, 12.0);
    float ang = acos(clamp(dot(d, c), -1.0, 1.0));
    float th = angAround(d, c);
    float lanes = 140.0;
    float lf = (th / 6.2831853 + 0.5) * lanes;
    float lane = floor(lf);
    float h = hash3(int(lane), 3, 9), h2 = hash3(int(lane), 5, 1);
    float speed = (0.25 + h * 0.6) * (0.6 + LIVELY);
    float r = ang / 3.14159265;
    float head = fract(T * speed * 0.18 + h2);
    float s = head * head;
    float dr = s - r;
    float len = 0.04 + 0.12 * s;
    float streak = dr >= 0.0 ? (dr <= len * 4.0 ? exp(-dr / len) : 0.0) : exp(dr / 0.004);
    float width = 1.0 - abs(lf - lane - 0.5) * 2.0;
    streak *= pow(width, 3.0) * (h2 >= 0.45 ? 1.0 : 0.0) * sm(0.0, 0.05, r);
    addMix(h, streak * 1.1 * PATTERN);
    add(A1, exp(-ang * 8.0) * 0.6 * BREATH + exp(-ang * 2.0) * 0.12);
    add(SPLAT3(1.0), exp(-ang * 40.0) * 0.9);
}

void silk(float az, float el) {
    if (el < -4.0) return;
    float azr = radians(az), t = T * (0.12 + LIVELY * 0.15);
    for (int k = 0; k < 3; k++) {
        float fk = float(k);
        float c = 22.0 + fk * 16.0 + 9.0 * sin(azr * 2.0 + t + fk * 2.1) + 5.0 * sin(azr * 5.0 - t * 1.4 + fk);
        float w = 4.0 + 2.5 * sin(azr * 3.0 + t * 0.7 + fk);
        float h = (el - c) / w;
        float band = exp(-h * h);
        if (band < 0.01) continue;
        float fold = 0.55 + 0.45 * sin(azr * 18.0 + 3.0 * sin(azr * 3.0 + t) + t * 2.0 + fk);
        float sheen = pow(max(0.0, 1.0 - abs(h)), 6.0);
        addMix(0.5 + 0.5 * sin(azr * 2.0 + fk * 2.0 + t * 0.3), band * (0.35 + 0.65 * fold) * 0.6 * PATTERN * BREATH);
        add(SPLAT3(1.0), sheen * fold * 0.25 * PATTERN);
    }
}

void eclipse(float x, float y, float z, float el) {
    vec3 d = vec3(x, y, z), c = sdir(160.0, 26.0);
    float ang = degrees(acos(clamp(dot(d, c), -1.0, 1.0)));
    float th = angAround(d, c);
    float R = 4.6;
    add(A2, exp(-max(0.0, el) / 7.0) * 0.55);
    float stream = 0.55 + 0.45 * lfNoise(th * 2.5, T * 0.05, 3.0);
    float rays = pow(0.5 + 0.5 * sin(th * 9.0 + lfNoise(th, T * 0.1, 7.0) * 5.0), 4.0);
    float outer = max(0.0, ang - R);
    float corona = exp(-outer / (2.2 + 4.0 * rays * stream)) * (0.8 + 0.4 * rays);
    add(A1, corona * 1.1 * PATTERN * BREATH);
    add(SPLAT3(1.0), exp(-outer / 0.5) * 0.9);
    add(A1, exp(-outer / 9.0) * 0.4 * BREATH + exp(-outer / 1.6) * 0.5);
    float disc = 1.0 - sm(R - 0.15, R, ang);
    over(vec3(0.01, 0.008, 0.012), disc);
}

float soft(float v) {
    if (v <= 0.8) return max(0.0, v);
    float o = v - 0.8;
    return 0.8 + 0.2 * (o / (o + 0.2));
}

vec3 rgb(float r, float g, float b) {
    return vec3(r, g, b) / 255.0;
}


// ---------------------------------------------------------------- [LyricsForge] realistic skies (ordinals 38..42)
// Real-sky look instead of painted fantasy: a Rayleigh-style blue that pales to the horizon, a Mie glow around the
// sun, and a deck of real-shaped clouds (domain-warped fbm on a sky plane) that drift fast, self-shadow away from the
// sun and get a silver lining toward it. PULSE (music energy + a kick on drops) speeds the wind, brightens the light
// and pushes the colour; the world takes the sky's colour from the same palette.
GLOBAL float PULSE;
// ==== LF KIT BEGIN
// ================================================================ [LyricsForge] polished sky kit
// Shared building blocks for the reworked skies: stars with real magnitudes and colours, a Milky Way with dust
// lanes and star clouds, emission nebulae with filaments, a cumulus deck that can be lit from the sun, from below
// (city, lava) or from inside (lightning), crepuscular rays in the sun's own frame (no seams at the zenith), ice
// halos, rainbows, an eclipse corona and a filmic tone curve (bright stays bright without going flat white).
GLOBAL float LIGHTNING, KICK, BEAT, WAVE;

vec3 v3(float a) { return vec3(a, a, a); }
float fbm3(vec3 p, int oct) { return fbm(p.x, p.y, p.z, oct); }
float noise3(vec3 p) { return lfNoise(p.x, p.y, p.z); }
float rfbm(vec3 p, int oct) { // ridged: thin bright filaments
    float s = 0.0, a = 0.5, n = 0.0;
    for (int i = 0; i < oct; i++) {
        float r = 1.0 - abs(2.0 * noise3(p) - 1.0);
        s += r * r * a; n += a;
        p = p * 2.03 + vec3(17.1, -9.7, 3.3);
        a *= 0.5;
    }
    return s / n;
}
float lum3(vec3 c) { return dot(c, vec3(0.2126, 0.7152, 0.0722)); }
float angTo(vec3 d, vec3 c) { return acos(clamp(dot(d, c), -1.0, 1.0)); }
void frameOf(vec3 c, out vec3 t1, out vec3 t2) {
    vec3 up = abs(c.y) > 0.95 ? vec3(1.0, 0.0, 0.0) : vec3(0.0, 1.0, 0.0);
    t1 = normalize(cross(up, c));
    t2 = cross(c, t1);
}
vec3 dirAE(float azDeg, float elDeg) {
    float a = radians(azDeg), e = radians(elDeg);
    return vec3(-sin(a) * cos(e), sin(e), cos(a) * cos(e));
}

// stars: two magnitude layers on a 3D cell grid; real colour temperatures; a gentle twinkle
vec3 starField(vec3 d, float dens, float bright) {
    vec3 acc = v3(0.0);
    for (int l = 0; l < 3; l++) {
        float K = l == 0 ? 48.0 : (l == 1 ? 105.0 : 210.0);
        vec3 p = d * K;
        vec3 c = floor(p);
        vec3 j = sh33(c + float(l) * 31.7);
        if (j.x > dens * (l == 0 ? 0.30 : (l == 1 ? 0.22 : 0.10))) continue;
        vec3 sp = c + 0.2 + 0.6 * sh33(c + 4.1 + float(l));
        float dist = length(cross(d, normalize(sp))) * K;
        float mag = l == 0 ? 0.55 + 0.6 * j.y * j.y : (l == 1 ? 0.22 + 0.3 * j.y : 0.10 + 0.12 * j.y);
        float sz = l == 0 ? 0.075 : (l == 1 ? 0.10 : 0.14);
        float tw = 0.78 + 0.22 * sin(T * (1.5 + 3.0 * j.z) + j.y * 40.0);
        vec3 col = j.z < 0.33 ? vec3(0.72, 0.82, 1.0) : (j.z < 0.8 ? vec3(1.0, 0.97, 0.92) : vec3(1.0, 0.8, 0.6));
        acc += col * exp(-dist * dist / (sz * sz)) * mag * tw;
    }
    return acc * bright;
}

// Milky Way: a band with a brighter, warmer bulge, star clouds, fine star dust and dark lanes (the Great Rift)
vec3 milky(vec3 d, float s, vec3 warm, vec3 cool) {
    vec3 n = normalize(vec3(0.36, 0.58, 0.73));
    vec3 gc = normalize(vec3(-0.58, 0.36, 0.0) - n * dot(vec3(-0.58, 0.36, 0.0), n));
    float b = dot(d, n);
    float bulge = exp(-max(0.0, 1.0 - dot(d, gc)) * 3.0);
    float width = 0.11 + 0.13 * bulge;
    float band = exp(-b * b / (width * width));
    if (band < 0.004) return v3(0.0);
    vec3 p = d * 4.0;
    vec3 w = vec3(fbm3(p * 0.9 + 1.3, 2), fbm3(p * 0.9 + 7.1, 2), fbm3(p * 0.9 - 3.7, 2)) - 0.5;
    float cl = fbm3(p * 1.8 + w * 1.3, 4);
    float grain = noise3(d * 170.0) * noise3(d * 330.0 + 5.0);
    float lane = rfbm(p * 2.4 + w * 0.9, 3);
    float bo = b + 0.02 * sin(dot(d, gc) * 9.0);
    float laneMask = exp(-bo * bo / (0.0016 + 0.004 * bulge));
    float dust = sm(0.42, 0.8, lane) * laneMask + 0.35 * sm(0.55, 0.9, lane) * band;
    float L = band * (0.2 + 1.2 * sm(0.3, 0.85, cl)) * (0.6 + 1.6 * grain) * (1.0 - 0.9 * clamp(dust, 0.0, 1.0));
    L *= 0.55 + 1.3 * bulge;
    vec3 col = mix(cool, warm, clamp(0.85 * bulge + 0.25 * (cl - 0.5), 0.0, 1.0));
    return col * L * s;
}

// emission nebula around direction c: hydrogen glow (cA), oxygen glow (cB), filaments and dark dust
vec3 nebulaCloud(vec3 d, vec3 c, vec3 cA, vec3 cB, float size, float s) {
    float a = angTo(d, c);
    float fall = exp(-a * a / (size * size));
    if (fall < 0.02) return v3(0.0);
    vec3 p = d * 2.4 + vec3(0.0, T * 0.003, 0.0);
    vec3 w = (vec3(fbm3(p, 2), fbm3(p + 5.2, 2), fbm3(p - 3.1, 2)) - 0.5) * 1.5; // [perf] 2 octaves: the warp is low-frequency anyway
    float gas = fbm3(p * 1.15 + w, 5);
    float neb = sm(0.40, 0.86, gas) * fall;                                  // the main glow: smooth, billowing
    float fil = neb > 0.01 ? pow(rfbm(p * 2.0 + w * 1.3, 3), 4.0) * neb * 1.4 : 0.0; // filaments, only inside the glow
    float ox = fall > 0.05 ? sm(0.50, 0.86, fbm3(p * 0.95 - w + 9.0, 3)) * fall : 0.0;          // a second gas (other colour), offset
    float dust = fall > 0.05 ? sm(0.52, 0.80, fbm3(p * 1.7 + w * 0.6 + 20.0, 3)) : 0.0;         // broad dark lanes, not a web
    vec3 col = cA * (neb * 0.55 + fil * 0.9) + cB * ox * 0.45 * (1.1 - neb);
    col *= 1.0 - 0.8 * dust * sm(0.15, 0.6, fall);
    col += mix(cA, v3(1.0), 0.5) * exp(-a * a / (size * size * 0.04)) * 0.12;
    return col * s;
}

// a cumulus deck on a sky plane (the realistic skies' clouds, shared). lit/shade: sunlit and shadowed colour;
// glowBelow: light from under the clouds (a city, lava); flash: lightning inside the clouds right now
void cumulus(float x, float y, float z, vec3 lit, vec3 shade, vec3 sunC, vec3 hor, float cover, float scale,
             float speed, float haze, float opac, vec3 glowBelow, float flash, vec3 flashC) {
    if (y <= 0.012) return;
    float mu = max(0.0, x * SUN.x + y * SUN.y + z * SUN.z);
    float pulse = clamp(PULSE, 0.0, 1.6);
    float s = 1.0 / (y + 0.08);
    float ux = x * s, uz = z * s;
    float t = T * speed * (1.0 + 1.2 * LIVELY) * (1.0 + 0.9 * pulse);
    float sc = scale * 1.5;
    float px_ = ux * sc + t, pz = uz * sc + t * 0.35;
    float w1 = fbm(px_ * 0.35, pz * 0.35, 2.7, 3);
    float cx = px_ + w1 * 0.9, cz = pz + w1 * 0.7;
    float n = fbm(cx, cz, t * 0.15, 6);
    float m = fbm(px_ * 0.12 + 5.0, pz * 0.12 - 3.0, 1.1, 3);
    float cl = cover + (0.5 - m) * 0.35;
    float d = sm(cl, cl + 0.09, n) * sm(0.0, 0.14, y);
    if (d < 0.004) return;
    float core = sm(cl, cl + 0.32, n);
    float sx = SUN.x, sz = SUN.z, sn = max(1e-3, sqrt(sx * sx + sz * sz));
    float n2 = fbm(cx + sx / sn * 0.18, cz + sz / sn * 0.18, t * 0.15, 5);
    float occl = sm(cl, cl + 0.28, n2);
    float lightK = clamp(1.0 - occl * 0.5 * (0.4 + 0.6 * core), 0.0, 1.0);
    float base = sm(0.0, 0.25, n - n2 + 0.08);                     // the side away from the sun: a greyer base
    vec3 cc = mix(shade, lit * 0.93, lightK) * (1.0 - 0.20 * core) * (1.0 - 0.12 * base);
    float back = pow(mu, 4.0);                                     // looking toward the sun: dense cores go dark,
    cc = mix(cc, shade * 1.05, back * core * 0.65);                // only the thin edges catch the light
    cc += sunC * pow(mu, 8.0) * (1.0 - core) * (1.0 - core) * 1.1;
    cc += glowBelow * (0.35 + 0.65 * core) * (1.0 - 0.5 * lightK);
    if (flash > 0.001) { // lightning: the cloud lights up from inside around a moving spot
        float fx = sin(T * 0.37) * 2.0, fz = cos(T * 0.29) * 2.0 + 2.0;
        float near = exp(-((px_ - t - fx) * (px_ - t - fx) + (pz - t * 0.35 - fz) * (pz - t * 0.35 - fz)) / 6.0);
        cc += flashC * flash * (0.10 + 1.1 * near) * (0.45 + 0.55 * core);
    }
    cc = mix(cc, hor, haze * (1.0 - sm(0.0, 0.3, y)));
    cc *= 1.0 + 0.12 * pulse;
    over(cc, d * opac);
}

// crepuscular rays around the sun, built in the sun's own frame: smooth everywhere, no seam at the zenith
float sunRays(vec3 d, vec3 sun, float count, float sharp) {
    float mu = dot(d, sun);
    if (mu < 0.0) return 0.0;
    vec3 t1, t2;
    frameOf(sun, t1, t2);
    vec3 q = d - sun * mu;
    float around = atan2(dot(q, t2), dot(q, t1));
    float n = noise3(vec3(cos(around) * 2.5, sin(around) * 2.5, T * 0.06));
    float r = pow(0.5 + 0.5 * sin(around * count + n * 5.0 + T * 0.05), sharp);
    float r2 = pow(0.5 + 0.5 * sin(around * count * 1.7 - n * 3.0 - T * 0.03), sharp * 1.5);
    return (0.65 * r + 0.35 * r2) * pow(mu, 2.0) * sm(0.0, 0.25, mu);
}

// 22-degree ice halo, sundogs, upper tangent arc, a sun pillar (real ice-crystal optics)
void iceHalo(vec3 d, vec3 sun, vec3 light, float s) {
    float a = degrees(angTo(d, sun));
    float ring = exp(-(a - 22.0) * (a - 22.0) / 0.8) * 0.26 + exp(-(a - 22.8) * (a - 22.8) / 5.0) * 0.10;
    vec3 rc = mix(vec3(1.0, 0.62, 0.42), light, sm(21.6, 22.8, a)); // a thin warm inner edge, white outside
    float inside = sm(22.0, 15.0, a) * 0.10; // the sky inside the halo is a touch darker
    C *= 1.0 - inside * s;
    add(rc, ring * s);
    // sundogs: bright spots on the horizon circle of the sun, 22 degrees left and right
    float de = degrees(asin(clamp(d.y, -1.0, 1.0))) - degrees(asin(clamp(sun.y, -1.0, 1.0)));
    vec3 hs = normalize(vec3(sun.x, 0.0, sun.z)), hd = normalize(vec3(d.x, 0.0, d.z) + 1e-5);
    float daz = degrees(acos(clamp(dot(hs, hd), -1.0, 1.0)));
    float dog = exp(-(daz - 23.0) * (daz - 23.0) / 1.6 - de * de / 3.5);
    float tail = exp(-de * de / 1.5) * sm(23.0, 26.0, daz) * exp(-(daz - 23.0) / 8.0);
    add(mix(vec3(1.0, 0.6, 0.4), light, sm(22.5, 24.0, daz)), (dog * 1.1 + tail * 0.25) * s);
    // sun pillar: a vertical streak of light through the sun
    float side = length(vec2(d.x, d.z) - normalize(vec2(sun.x, sun.z)) * length(vec2(d.x, d.z)));
    add(light, exp(-side * side / 0.0006) * exp(-abs(de) / 9.0) * 0.35 * s);
}

// rainbow at 42 degrees round the anti-sun (secondary at 51, reversed; Alexander's dark band between)
void rainbow(vec3 d, vec3 sun, float s) {
    vec3 anti = -sun;
    float a = degrees(angTo(d, anti));
    float fade = sm(-2.0, 6.0, degrees(asin(clamp(d.y, -1.0, 1.0)))) * s;
    if (fade < 0.001) return;
    float u = (a - 40.5) / 2.2; // 0 violet .. 1 red across the primary
    vec3 spec = clamp(vec3(1.5 - abs(u - 1.0) * 3.0, 1.5 - abs(u - 0.55) * 3.0, 1.5 - abs(u - 0.1) * 3.0), 0.0, 1.0);
    float band = sm(-0.3, 0.1, u) * sm(1.3, 0.9, u);
    add(spec, band * 0.33 * fade);
    float u2 = (53.5 - a) / 3.2; // secondary: red inside
    vec3 spec2 = clamp(vec3(1.5 - abs(u2 - 1.0) * 3.0, 1.5 - abs(u2 - 0.55) * 3.0, 1.5 - abs(u2 - 0.1) * 3.0), 0.0, 1.0);
    float band2 = sm(-0.3, 0.1, u2) * sm(1.3, 0.9, u2);
    add(spec2, band2 * 0.12 * fade);
    C *= 1.0 - 0.18 * sm(43.0, 44.5, a) * sm(50.5, 49.0, a) * fade; // Alexander's band
    add(v3(1.0), 0.06 * sm(40.0, 20.0, a) * fade);                  // brighter inside the bow
}

// filmic shoulder on the brightest channel: hue kept, highlights roll off softly into a warm white
vec3 toneMap(vec3 c) {
    c = max(c, v3(0.0));
    float m = max(c.r, max(c.g, c.b));
    if (m <= 0.72) return c;
    float f = 0.72 + 0.28 * (1.0 - exp(-(m - 0.72) / 0.28));
    vec3 o = c * (f / m);
    return mix(o, v3(f), 0.35 * sm(1.3, 3.5, m));
}
// ==== LF KIT END
// searchlights over a city: beams rising from the horizon, leaning slowly, wider at the base
void searchlights(vec3 d, vec3 c1, vec3 c2, float s) {
    float el = degrees(asin(clamp(d.y, -1.0, 1.0)));
    if (el < -1.0 || el > 80.0) return;
    for (int i = 0; i < 3; i++) {
        float fi = float(i);
        float az0 = 150.0 + fi * 32.0 + 6.0 * sin(T * 0.11 + fi);
        float lean = 22.0 * sin(T * (0.19 + 0.05 * fi) + fi * 2.1);
        vec3 base = dirAE(az0, 0.0), top = dirAE(az0 + lean, 62.0 - 9.0 * fi);
        vec3 nrm = normalize(cross(base, top));
        float off = abs(dot(d, nrm));
        float w = 0.0035 + 0.011 * sm(55.0, 0.0, el);
        float topEl = 62.0 - 9.0 * fi;
        float gate = sm(-1.0, 1.5, el) * sm(topEl + 6.0, topEl - 26.0, el) * step(0.0, dot(d, base));
        float core = exp(-off * off / (w * w * 0.35)), halo = exp(-off * off / (w * w * 9.0));
        vec3 bc = mix(c1, c2, fi * 0.5);
        add(mix(bc, v3(1.0), 0.5), core * gate * (0.10 + 0.25 * exp(-el / 16.0)) * s);
        add(bc, halo * gate * (0.05 + 0.16 * exp(-el / 10.0)) * s);
        add(bc, exp(-angTo(d, base) * angTo(d, base) / 0.004) * 0.25 * s);
    }
}

// [LyricsForge] the realistic sky engine: real gradient, Mie sun glow, cirrus + cumulus that self-shadow and light
// up from the sun, from below or from inside. Kinds 0..4: the realistic skies; 5..18: the reworked skies that
// belong in a real sky (golden hour, storms, a rainbow after rain, ice halos, a city at night...)
void realSky(float x, float y, float z, float el, int kind) {
    vec3 zen = v3(0.5), hor = v3(0.7), sunC = v3(1.0), lit = v3(1.0), shade = v3(0.5), accent = v3(1.0);
    float cover = 0.5, speed = 0.04, haze = 0.55, opac = 0.95, scale = 0.9;
    float rays = 0.0, stars = 0.0, flash = 0.0;
    vec3 below = v3(0.0);
    float yy = max(y, 0.0);
    if (kind == 0) {        // Summer Day: deep blue, big bright cumulus racing past
        zen = rgb(28.0, 92.0, 214.0); hor = rgb(176.0, 214.0, 248.0); sunC = rgb(255.0, 244.0, 222.0);
        lit = rgb(255.0, 255.0, 255.0); shade = rgb(120.0, 140.0, 178.0); accent = rgb(90.0, 190.0, 255.0);
        cover = 0.50; speed = 0.050; haze = 0.55; opac = 0.97; scale = 1.0;
    } else if (kind == 1) { // Pastel Dawn
        zen = rgb(70.0, 118.0, 230.0); hor = rgb(255.0, 196.0, 206.0); sunC = rgb(255.0, 214.0, 186.0);
        lit = rgb(255.0, 228.0, 238.0); shade = rgb(150.0, 136.0, 196.0); accent = rgb(255.0, 140.0, 200.0);
        cover = 0.53; speed = 0.042; haze = 0.6; opac = 0.93; scale = 0.9;
    } else if (kind == 2) { // Wildfire Dusk: orange and magenta, cloud bellies glowing from below
        zen = rgb(46.0, 40.0, 120.0); hor = rgb(255.0, 132.0, 72.0); sunC = rgb(255.0, 168.0, 96.0);
        lit = rgb(255.0, 176.0, 120.0); shade = rgb(92.0, 48.0, 108.0); accent = rgb(255.0, 80.0, 150.0);
        cover = 0.52; speed = 0.036; haze = 0.65; opac = 0.95; scale = 0.9;
        below = rgb(255.0, 110.0, 60.0) * 0.30 * exp(-yy * 3.0);
    } else if (kind == 3) { // Bright Night: a glowing blue night at eye level, a vivid Milky Way above
        zen = rgb(16.0, 12.0, 60.0); hor = rgb(40.0, 96.0, 190.0); sunC = rgb(200.0, 220.0, 255.0);
        lit = rgb(170.0, 190.0, 255.0); shade = rgb(28.0, 32.0, 78.0); accent = rgb(200.0, 90.0, 255.0);
        cover = 0.62; speed = 0.03; haze = 0.5; opac = 0.7; scale = 0.8; stars = 1.0;
    } else if (kind == 4) { // Silver Lining: towering clouds, the sun breaking through with real rays
        zen = rgb(40.0, 84.0, 170.0); hor = rgb(196.0, 214.0, 232.0); sunC = rgb(255.0, 236.0, 200.0);
        lit = rgb(255.0, 250.0, 240.0); shade = rgb(86.0, 98.0, 126.0); accent = rgb(255.0, 210.0, 140.0);
        cover = 0.47; speed = 0.04; haze = 0.5; opac = 1.0; scale = 0.75; rays = 0.22;
    } else if (kind == 5) { // Golden Hour: low sun, honey light, gold-rimmed clouds and long rays
        zen = rgb(58.0, 62.0, 140.0); hor = rgb(255.0, 168.0, 92.0); sunC = rgb(255.0, 196.0, 120.0);
        lit = rgb(255.0, 206.0, 148.0); shade = rgb(118.0, 82.0, 112.0); accent = rgb(255.0, 120.0, 70.0);
        cover = 0.52; speed = 0.035; haze = 0.6; opac = 0.95; scale = 0.9; rays = 0.30;
        below = rgb(255.0, 150.0, 80.0) * 0.16 * exp(-yy * 3.0);
    } else if (kind == 6) { // Cotton Candy: blue up top, pink at the horizon, soft bluish clouds racing past
        zen = rgb(70.0, 130.0, 245.0); hor = rgb(255.0, 196.0, 226.0); sunC = rgb(255.0, 240.0, 246.0);
        lit = rgb(242.0, 244.0, 255.0); shade = rgb(150.0, 160.0, 226.0); accent = rgb(255.0, 150.0, 215.0);
        cover = 0.50; speed = 0.075; haze = 0.55; opac = 0.92; scale = 1.0;
    } else if (kind == 7) { // Sakura: a rose sunrise, pink-lit clouds, soft rays (petals fall in front)
        zen = rgb(98.0, 70.0, 160.0); hor = rgb(255.0, 176.0, 212.0); sunC = rgb(255.0, 196.0, 222.0);
        lit = rgb(255.0, 214.0, 234.0); shade = rgb(150.0, 100.0, 160.0); accent = rgb(255.0, 110.0, 190.0);
        cover = 0.55; speed = 0.035; haze = 0.65; opac = 0.9; scale = 0.9; rays = 0.10;
    } else if (kind == 8) { // Storm: a low slate deck racing overhead, lightning lighting the clouds from inside
        zen = rgb(34.0, 40.0, 52.0); hor = rgb(88.0, 98.0, 114.0); sunC = rgb(150.0, 160.0, 175.0);
        lit = rgb(126.0, 136.0, 150.0); shade = rgb(28.0, 32.0, 42.0); accent = rgb(170.0, 190.0, 255.0);
        cover = 0.30; speed = 0.085; haze = 0.7; opac = 1.0; scale = 0.7; flash = 1.0;
    } else if (kind == 9) { // Inferno: an ash cloud deck lit from below by lava, a burning horizon
        zen = rgb(26.0, 10.0, 10.0); hor = rgb(170.0, 56.0, 20.0); sunC = rgb(255.0, 120.0, 40.0);
        lit = rgb(52.0, 28.0, 26.0); shade = rgb(12.0, 7.0, 8.0); accent = rgb(255.0, 90.0, 20.0);
        cover = 0.42; speed = 0.028; haze = 0.45; opac = 1.0; scale = 0.75;
        float flick = 0.8 + 0.2 * noise3(vec3(x * 2.0, T * 0.9, z * 2.0)) + 0.25 * BEAT;
        below = rgb(255.0, 92.0, 24.0) * (1.05 * exp(-yy * 1.7) + 0.16) * flick;
    } else if (kind == 10) { // Prism: the sky after rain, a double rainbow opposite the sun
        zen = rgb(46.0, 92.0, 175.0); hor = rgb(190.0, 206.0, 222.0); sunC = rgb(255.0, 240.0, 215.0);
        lit = rgb(250.0, 246.0, 238.0); shade = rgb(92.0, 104.0, 128.0); accent = rgb(170.0, 210.0, 255.0);
        cover = 0.52; speed = 0.04; haze = 0.5; opac = 0.96; scale = 0.8;
    } else if (kind == 11) { // Frost: a polar day, thin ice haze, a 22-degree halo with sundogs and a sun pillar
        zen = rgb(30.0, 80.0, 185.0); hor = rgb(205.0, 226.0, 246.0); sunC = rgb(255.0, 250.0, 240.0);
        lit = rgb(255.0, 255.0, 255.0); shade = rgb(175.0, 195.0, 222.0); accent = rgb(150.0, 220.0, 255.0);
        cover = 0.64; speed = 0.03; haze = 0.55; opac = 0.55; scale = 1.1;
    } else if (kind == 12) { // Ocean: a bright ocean day, towering white cumulus
        zen = rgb(16.0, 92.0, 210.0); hor = rgb(150.0, 214.0, 248.0); sunC = rgb(255.0, 246.0, 226.0);
        lit = rgb(255.0, 255.0, 255.0); shade = rgb(110.0, 135.0, 175.0); accent = rgb(60.0, 200.0, 255.0);
        cover = 0.45; speed = 0.05; haze = 0.5; opac = 0.98; scale = 0.6;
    } else if (kind == 13) { // Dream Ocean: a pastel evening, lilac and rose
        zen = rgb(80.0, 86.0, 190.0); hor = rgb(255.0, 198.0, 214.0); sunC = rgb(255.0, 214.0, 190.0);
        lit = rgb(255.0, 222.0, 228.0); shade = rgb(140.0, 124.0, 190.0); accent = rgb(150.0, 255.0, 240.0);
        cover = 0.55; speed = 0.04; haze = 0.6; opac = 0.92; scale = 0.85;
    } else if (kind == 14) { // Sunset: the sun on the horizon, fire-lit clouds
        zen = rgb(52.0, 34.0, 112.0); hor = rgb(255.0, 104.0, 40.0); sunC = rgb(255.0, 150.0, 70.0);
        lit = rgb(255.0, 150.0, 80.0); shade = rgb(84.0, 36.0, 76.0); accent = rgb(255.0, 70.0, 110.0);
        cover = 0.5; speed = 0.033; haze = 0.65; opac = 0.96; scale = 0.85; rays = 0.2;
        below = rgb(255.0, 90.0, 40.0) * 0.35 * exp(-yy * 3.0);
    } else if (kind == 15) { // Thunder: a night thunderstorm
        zen = rgb(8.0, 12.0, 26.0); hor = rgb(26.0, 38.0, 70.0); sunC = rgb(120.0, 140.0, 200.0);
        lit = rgb(50.0, 62.0, 96.0); shade = rgb(10.0, 13.0, 24.0); accent = rgb(140.0, 170.0, 255.0);
        cover = 0.32; speed = 0.08; haze = 0.6; opac = 1.0; scale = 0.7; flash = 1.0; stars = 0.35;
    } else if (kind == 16) { // Cherry: a pink moonlit night
        zen = rgb(28.0, 14.0, 46.0); hor = rgb(140.0, 56.0, 118.0); sunC = rgb(255.0, 200.0, 230.0);
        lit = rgb(200.0, 140.0, 190.0); shade = rgb(40.0, 20.0, 48.0); accent = rgb(255.0, 120.0, 200.0);
        cover = 0.6; speed = 0.03; haze = 0.6; opac = 0.8; scale = 0.9; stars = 0.55;
    } else if (kind == 17) { // Crimson: a blood-red dusk, dark clouds with burning undersides
        zen = rgb(30.0, 6.0, 12.0); hor = rgb(200.0, 40.0, 30.0); sunC = rgb(255.0, 90.0, 50.0);
        lit = rgb(220.0, 76.0, 58.0); shade = rgb(40.0, 8.0, 14.0); accent = rgb(255.0, 40.0, 40.0);
        cover = 0.5; speed = 0.035; haze = 0.6; opac = 0.95; scale = 0.85;
        below = rgb(255.0, 60.0, 40.0) * 0.35 * exp(-yy * 3.0);
    } else {                // 18 Neon City: a city night, low clouds lit from below, searchlights
        zen = rgb(10.0, 8.0, 28.0); hor = rgb(60.0, 20.0, 80.0); sunC = v3(0.0);
        lit = rgb(70.0, 40.0, 90.0); shade = rgb(14.0, 10.0, 26.0); accent = rgb(255.0, 60.0, 170.0);
        cover = 0.46; speed = 0.03; haze = 0.5; opac = 0.9; scale = 0.8; stars = 0.25;
        below = mix(A1, A2, 0.5 + 0.5 * sin(x * 3.0 + T * 0.1)) * 0.5 * exp(-yy * 1.8);
    }
    float pulse = clamp(PULSE, 0.0, 1.6);
    // the drop pushes the whole palette toward its accent and saturates it; it eases back but never goes dull
    zen = mix(zen, accent * 0.9, 0.16 * pulse);
    hor = mix(hor, accent, 0.12 * pulse);
    vec3 d = vec3(x, y, z);
    float mu = max(0.0, x * SUN.x + y * SUN.y + z * SUN.z);
    bool hasSun = BKIND >= 0 && SUN.y > -0.3;
    // 1) sky: Rayleigh-ish gradient (bluer and darker up, paler and brighter near the horizon)
    C = mix(hor, zen, pow(clamp(yy * 1.15, 0.0, 1.0), 0.42));
    add(hor, 0.18 * exp(-yy * 9.0));
    if (el < 0.0) C = mix(C, hor * 0.75, clamp(-el / 10.0, 0.0, 1.0));
    if (hasSun) add(sunC, (pow(mu, 6.0) * 0.28 + pow(mu, 64.0) * 0.45 + pow(mu, 900.0) * 1.2) * (1.0 + 0.12 * pulse) * (stars > 0.0 ? 0.3 : 1.0));
    if (stars > 0.0) { // the night sky itself
        add(starField(d, 1.0, 1.0) * stars, sm(-2.0, 10.0, el));
        if (kind == 3) {
            add(milky(d, 0.55, rgb(255.0, 214.0, 190.0), rgb(150.0, 170.0, 255.0)), 1.0 + 0.4 * pulse);
            add(nebulaCloud(d, normalize(vec3(-0.5, 0.55, 0.65)), accent * 0.6, rgb(80.0, 200.0, 255.0) * 0.5, 0.45, 0.7 * PATTERN), 1.0 + 0.5 * pulse);
            add(rgb(60.0, 140.0, 255.0), 0.10 * exp(-yy * 5.0) * (1.0 + 0.5 * pulse));
        }
    }
    if (kind == 9) add(rgb(255.0, 90.0, 20.0), (0.35 * exp(-yy * 6.0)) * (0.9 + 0.2 * BEAT));
    if (kind == 18) {
        add(A1, 0.30 * exp(-yy * 7.0)); add(A2, 0.12 * exp(-yy * 3.0)); // light pollution over the city
        searchlights(d, A2, rgb(255.0, 240.0, 255.0), 1.0 + 0.6 * pulse);
    }
    if (rays > 0.0 && hasSun) add(sunC, sunRays(d, SUN, 13.0, 5.0) * mu * rays * (1.0 + 0.35 * pulse));
    if (kind == 10 && hasSun) rainbow(d, SUN, 0.9 + 0.3 * pulse);
    if (kind == 11 && hasSun) iceHalo(d, SUN, v3(1.0), 0.9 + 0.3 * pulse);
    if (flash > 0.0) add(rgb(200.0, 210.0, 255.0), LIGHTNING * 0.10 * (0.3 + 0.7 * sm(-2.0, 30.0, el)));
    add(accent, 0.10 * KICK * exp(-yy * 4.0)); // the drop: a breath of the sky's own colour along the horizon
    // 2) clouds on a sky plane: real shapes from domain-warped fbm, moving with the wind (faster with the music)
    if (y > 0.015) {
        float s  = 1.0 / (y + 0.08);
        float ux = x * s, uz = z * s;
        float t  = T * speed * (1.0 + 1.2 * LIVELY) * (1.0 + 0.9 * pulse);
        // a thin high cirrus layer first (it is higher, so the cumulus passes in front of it), streaked by the wind
        float ci = fbm(ux * 0.12 + t * 0.4, uz * 1.1 + t * 0.12, 9.1, 4);
        float cd = sm(0.56, 0.8, ci) * sm(0.05, 0.4, y) * (stars > 0.0 ? 0.25 : 0.5) * (flash > 0.0 ? 0.3 : 1.0);
        if (cd > 0.004) over(mix(lit, hor, 0.35) * (1.0 + 0.08 * pulse), cd);
        cumulus(x, y, z, lit, shade, sunC, hor, cover, scale, speed, haze, opac, below, flash * LIGHTNING, rgb(210.0, 220.0, 255.0) * 1.3);
    }
}


