// which skies the realistic engine draws (and as which kind), -1 = their own code
int realKind(int p) {
    if (p >= 38) return p - 38;
    if (p == 6) return 5;   if (p == 7) return 6;   if (p == 8) return 7;   if (p == 13) return 8;
    if (p == 15) return 9;  if (p == 17) return 10; if (p == 9) return 11;  if (p == 22) return 12;
    if (p == 36) return 13; if (p == 25) return 14; if (p == 28) return 15; if (p == 26) return 16;
    if (p == 27) return 17; if (p == 5) return 18;
    return -1;
}

vec4 skyOne(vec3 skyDir, vec4 skyInfo4) {
    vec3 skyInfo = skyInfo4.xyz;
    PULSE = skyInfo4.w;
    TOP = px(0).rgb;
    HOR = px(1).rgb;
    A1 = px(2).rgb;
    A2 = px(3).rgb;
    vec4 b = px(4);
    BCOL = b.rgb;
    BKIND = int(floor(b.a * 255.0 + 0.5)) - 1;
    vec4 q = px(5);
    PATTERN = q.r * 1.5;
    LIVELY = q.g;
    BREATH = q.b;
    AURORA_ON = q.a;
    vec4 o6 = px(6), o7 = px(7);
    BAZ = u16(o6.rg) / 100.0;
    BEL = u16(o6.ba) / 100.0 - 90.0;
    BRAD = u16(o7.rg) / 1000.0;
    PRESET = int(floor(o7.b * 255.0 + 0.5));
    T = skyInfo.x;
    { vec4 m13 = px(13); LIGHTNING = m13.r; KICK = m13.g; BEAT = m13.b; WAVE = m13.a > 0.002 ? (m13.a * 255.0 - 1.0) / 254.0 : -1.0; }
    float ba = radians(BAZ), be = radians(BEL);
    SUN = vec3(-sin(ba) * cos(be), sin(be), cos(ba) * cos(be));

    vec3 dir = normalize(skyDir);
    { // [BF] LyricsForge: the dome turns so a sky's signature (sun, black hole, eclipse, burst) starts in front of you
        float yo = radians((u16(px(12).ba) - 32767.5) / 16383.5 * 360.0);
        float cy = cos(-yo), sy = sin(-yo);
        dir = vec3(dir.x * cy - dir.z * sy, dir.y, dir.z * cy + dir.x * sy);
    }
    float x = dir.x, y = dir.y, z = dir.z;
    float el = degrees(asin(clamp(y, -1.0, 1.0)));
    float az = degrees(atan2(-x, z));
    if (az < 0.0) az += 360.0;

    int rk = realKind(PRESET);
    if (rk < 0 && spaceSky(dir, az, el)) { // [LyricsForge] the reworked night / space / special skies
        if (BKIND >= 0) bodyGlow(x, y, z, az, el);
    } else if (rk >= 0) { // [LyricsForge] realistic skies + the skies reworked onto the same engine
        realSky(x, y, z, el, rk);
        if (BKIND >= 0) bodyGlow(x, y, z, az, el);
    } else if ((PRESET >= 20 && PRESET <= 28) || PRESET >= 34) { // painted (34..37: the LyricsForge skies)
        // gemalte Himmel: komplett eigene Rechnung (Zeit in Sekunden)
        C = styledSky(dir, PRESET <= 28 ? PRESET - 20 : PRESET - 25, T / 2.2);
    } else {
    // 1) ruhiger Verlauf vom Horizont nach oben
    float k = pow(clamp(el / 72.0, 0.0, 1.0), 0.55);
    C = mix(HOR, TOP, k);
    if (el < 0.0) C *= 1.0 - clamp(-el / 6.0, 0.0, 1.0) * 0.55;
    float lowGlow = exp(-max(0.0, el) / 9.0);

    if (PRESET == 0) { synth(el); add(starField(vec3(x, y, z), 0.8, 0.8), sm(8.0, 30.0, el)); }
    else if (PRESET == 1 || PRESET == 14) {
        milkyWay(x, y, z, 0.16);
        curtains(az, el, 1.0);
        add(A1, 0.06 * lowGlow);
    } else if (PRESET == 2) {
        swirl(x, y, z);
        add(A1, 0.10 * lowGlow);
    } else if (PRESET == 3) {
        milkyWay(x, y, z, 0.22);
        accretion(az, el);
    } else if (PRESET == 4) {
        galaxyBand(x, y, z);
        add(A2, 0.08 * lowGlow);
    } else if (PRESET == 5) {
        cityGlow(az, el);
        clouds(x, y, z, 0.62, 0.55, rgb(106.0, 44.0, 122.0), rgb(12.0, 10.0, 30.0), 0.03);
    } else if (PRESET == 6) {
        add(vec3(1.0, 0.55, 0.28), 0.5 * lowGlow);
        clouds(x, y, z, 0.54, 0.85, rgb(255.0, 196.0, 138.0), rgb(90.0, 44.0, 94.0), 0.02);
    } else if (PRESET == 7) {
        add(vec3(1.0, 0.8, 0.92), 0.14 * lowGlow);
        clouds(x, y, z, 0.6, 0.92, SPLAT3(1.0), rgb(242.0, 184.0, 216.0), 0.025);
    } else if (PRESET == 8) {
        add(vec3(1.0, 0.61, 0.8), 0.4 * lowGlow);
        clouds(x, y, z, 0.57, 0.6, rgb(255.0, 232.0, 242.0), rgb(200.0, 144.0, 184.0), 0.02);
    } else if (PRESET == 9) {
        iceBands(az, el);
        curtains(az, el, 0.45);
        milkyWay(x, y, z, 0.2);
    } else if (PRESET == 10) {
        milkyWay(x, y, z, 0.5);
        add(vec3(0.16, 0.23, 0.56), 0.18 * lowGlow);
    } else if (PRESET == 11) {
        caustics(x, y, z, el);
        add(A2, 0.16 * lowGlow);
    } else if (PRESET == 12) {
        add(vec3(0.85, 0.22, 0.16), 0.16 * lowGlow); // [BF] Blood Moon: darker, the red lives in the moon and the cloud edges
        clouds(x, y, z, 0.6, 0.75, rgb(128.0, 30.0, 40.0), rgb(16.0, 3.0, 6.0), 0.03);
    } else if (PRESET == 13) {
        clouds(x, y, z, 0.3, 0.97, rgb(90.0, 100.0, 120.0), rgb(18.0, 22.0, 31.0), 0.11);
    } else if (PRESET == 15) {
        lava(x, y, z, el);
        add(vec3(1.0, 0.35, 0.08), 0.35 * lowGlow);
    } else if (PRESET == 16) code(az, el);
    else if (PRESET == 17) prism(az, el);
    else if (PRESET == 18) {
        milkyWay(x, y, z, 0.25);
        pulsar(x, y, z);
    } else if (PRESET == 19) paint(x, y, z, el);
    else if (PRESET == 29) { // LyricsFlow 2.2
        milkyWay(x, y, z, 0.2);
        rift(x, y, z);
    } else if (PRESET == 30) {
        supernova(x, y, z);
        add(A2, 0.06 * lowGlow);
    } else if (PRESET == 31) warp(x, y, z);
    else if (PRESET == 32) {
        silk(az, el);
        add(A1, 0.12 * lowGlow);
    } else if (PRESET == 33) eclipse(x, y, z, el);
    if (BKIND >= 0) bodyGlow(x, y, z, az, el);
    }

    if (WAVE >= 0.0) { // [LyricsForge] the chorus light wave: a soft sweep down the dome in the sky's own colours
        float e = 1.0 - (1.0 - WAVE) * (1.0 - WAVE);
        float dd = el - (78.0 - 76.0 * e);
        float wa = sin(3.14159265 * min(1.0, WAVE * 1.05)) * min(1.0, WAVE * 6.0);
        vec3 wc = mix(A1, A2, 0.5 + 0.5 * sin(radians(az) * 2.0 + T * 0.7));
        if (lum3(wc) < 0.05) wc = mix(HOR, v3(1.0), 0.45); // skies without accent colours: their own horizon light
        float shimmer = 0.75 + 0.25 * noise3(vec3(cos(radians(az)) * 6.0, sin(radians(az)) * 6.0, T * 2.0));
        add(mix(wc, v3(1.0), 0.6), exp(-dd * dd / 1.4) * 0.45 * wa * shimmer);
        add(wc, (dd > 0.0 ? exp(-dd / 16.0) : exp(dd / 1.2)) * 0.14 * wa);
    }
    vec3 col = toneMap(C); // [LyricsForge] filmic shoulder (was a per-channel clip: drops went flat white)
    col = clamp(col * skyInfo.y, 0.0, 1.0);
    // deckend bis weit unter den Horizont (kein heller Minecraft-Nebel dazwischen), ganz unten weich aus
    float ht = clamp((el + 30.0) / 6.0, 0.0, 1.0);
    float a = skyInfo.z * ht * ht * (3.0 - 2.0 * ht);
    if (a <= 0.002) discard;
    return vec4(col, a);
}

// [LyricsForge] sky transitions: while a new sky sweeps in, both are drawn and wiped along a front that rises from the
// horizon over the zenith, a seam of the new sky's light riding on it (only during the ~1.6 s of the sweep)
vec4 skyMain(vec3 skyDir, vec4 skyInfo4) {
    PXB = 0;
    vec4 cn = skyOne(skyDir, skyInfo4);
    float swr = PX_FETCH(14).r;
    if (swr < 0.002) return cn;
    float sw = clamp((swr * 255.0 - 1.0) / 254.0, 0.0, 1.0);
    vec3 seamC = mix(A1, HOR, 0.4);
    if (lum3(seamC) < 0.05) seamC = v3(0.85);
    float el = degrees(asin(clamp(normalize(skyDir).y, -1.0, 1.0)));
    PXB = PX_PREV_BASE;
    vec4 co = skyOne(skyDir, vec4(skyInfo4.xyz, 0.0));
    PXB = 0;
    float e = sw * sw * (3.0 - 2.0 * sw);
    float front = -12.0 + 118.0 * e;
    float m = 1.0 - sm(front - 7.0, front + 7.0, el);
    vec4 c = mix(co, cn, m);
    float seam = exp(-(el - front) * (el - front) / 10.0) * sin(3.14159265 * sw);
    c.rgb = clamp(c.rgb + seamC * seam * 0.55, 0.0, 1.0);
    return c;
}
