// LyricsFlow port - live sky for Renderer Foundation. The dome look is shaders/live_sky.hlsl, generated by Bedrock
// Forge's tools/LyricsSky/gen_sky_shaders.py from LyricsFlow 2.1's live_sky.fsh (374m, MIT); its GLSL check build
// matches the original pixel for pixel. Data comes from Bedrock Forge each frame (BF_CopySkyFrame, BfLyrics.h):
// the 16x1 parameter row, the shader's vertex inputs, quads for stars / weather, and the picture / sprite images.
cbuffer SkyCB : register(b0) {
    float3 gF; float gTx;   // camera forward (world, +Y up), tan(hfov/2)
    float3 gR; float gTy;   // camera right (Minecraft: -X when facing +Z), tan(vfov/2)
    float3 gU; float gMode; // camera up; mode 0 = live dome, 1 = "My picture"
    float4 gInfo;           // x = time (UV0.x), y = brightness (Color.r * 2), z = alpha (Color.a), w = opacity (F6)
    float4 gPic;            // x = picture alpha, y = picture brightness
};
Buffer<float4>    gSkyParams : register(t0); // RGBA8_UNORM typed view of the parameter row
Texture2D<float4> gSprites   : register(t1); // 256 x 64: petal, snow, glow, streak
Texture2D<float4> gPicture   : register(t2); // equirectangular panorama
struct SkyVert { float3 pos; float2 uv; uint color; uint flags; float pad; };
StructuredBuffer<SkyVert> gVerts : register(t3);
SamplerState sLin  : register(s0); // clamp
SamplerState sWrap : register(s1); // wrap U (panorama seam)

#define PX_FETCH(i) gSkyParams.Load(i)
#include "live_sky.hlsl"

struct VOut {
    float4 pos : SV_Position;
    float3 dir : TEXCOORD0;
};

VOut VSSky(uint id : SV_VertexID) {
    float2 p = float2((id << 1) & 2, id & 2) * 2.0 - 1.0; // fullscreen triangle
    VOut o;
    o.pos = float4(p, 1.0, 1.0);
    o.dir = gF + gR * (p.x * gTx) + gU * (p.y * gTy);
    return o;
}

float4 PSSky(VOut i) : SV_Target {
    if (gMode > 0.5) { // SkyImage: 64 x 32 sphere with u = az / 360, v = 0.5 - el / 180
        float3 d  = normalize(i.dir);
        float  az = degrees(atan2(-d.x, d.z));
        if (az < 0.0) az += 360.0;
        float  el = degrees(asin(clamp(d.y, -1.0, 1.0)));
        float3 c  = gPicture.SampleLevel(sWrap, float2(az / 360.0, 0.5 - el / 180.0), 0).rgb * gPic.y;
        float  a  = saturate(gPic.x) * gInfo.w;
        return float4(c * a, a);
    }
    float4 c = skyMain(i.dir, gInfo.xyz);
    c.a *= gInfo.w;
    return float4(c.rgb * c.a, c.a); // premultiplied
}

// ---- stars / constellations / shooting stars / lightning / weather (WorldSky quads)
struct QOut {
    float4 pos : SV_Position;
    float2 uv : TEXCOORD0;
    float4 col : COLOR0;
    nointerpolation uint flags : TEXCOORD1;
};

QOut VSSkyQuad(uint vid : SV_VertexID) {
    static const uint kCorner[6] = {0, 1, 2, 0, 2, 3};
    SkyVert v = gVerts[(vid / 6) * 4 + kCorner[vid % 6]];
    float3  p = v.pos;
    QOut    o;
    float   z = dot(p, gF);
    o.pos   = float4(dot(p, gR) / gTx, dot(p, gU) / gTy, 0.0, z);
    o.pos.z = (v.flags & 1u) ? 0.0 : o.pos.w; // sky layer at the far plane
    o.uv    = v.uv;
    o.col   = float4(v.color & 255u, (v.color >> 8) & 255u, (v.color >> 16) & 255u, v.color >> 24) / 255.0;
    o.flags = v.flags;
    return o;
}

float4 PSSkyQuad(QOut i) : SV_Target {
    float4 c = i.col;
    if (i.flags & 2u) c *= gSprites.SampleLevel(sLin, i.uv, 0);
    c.a *= gInfo.w;
    return float4(c.rgb * c.a, c.a);
}
