// LyricsFlow port - live sky dome for Renderer Foundation. The look is shaders/live_sky.hlsl, generated by Bedrock
// Forge's tools/LyricsSky/gen_sky_shaders.py from LyricsFlow 2.1's live_sky.fsh (374m, MIT); its GLSL check build
// matches the original pixel for pixel. Inputs: the 16x1 parameter row from Bedrock Forge (Sky::pack) and a camera.
cbuffer SkyCB : register(b0) {
    float3 gF; float gTx;   // camera forward (world, +Y up), tan(hfov/2)
    float3 gR; float gTy;   // camera right, tan(vfov/2)
    float3 gU; float gPad;  // camera up
    float4 gInfo;           // x = time (UV0.x), y = brightness (Color.r * 2), z = alpha, w unused
};
Texture2D<float4> gSkyParams : register(t0);

#include "live_sky.hlsl"

struct VOut {
    float4 pos : SV_Position;
    float3 dir : TEXCOORD0;
};

VOut VSSky(uint id : SV_VertexID) {
    float2 p = float2((id << 1) & 2, id & 2) * 2.0 - 1.0; // fullscreen triangle
    VOut o;
    o.pos = float4(p, 1.0, 1.0);                          // z = far: depth test LESS_EQUAL keeps world geometry
    o.dir = gF + gR * (p.x * gTx) + gU * (p.y * gTy);
    return o;
}

float4 PSSky(VOut i) : SV_Target {
    float4 c = skyMain(i.dir, gInfo.xyz);
    return float4(c.rgb * c.a, c.a); // premultiplied
}
